{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Chromatic Command Action",
  "type": "object",
  "required": ["action_id", "mode", "label", "risk_level", "requires_confidence", "result_event_type"],
  "properties": {
    "action_id": {"type": "string"},
    "mode": {"type": "string", "enum": ["operator", "auditor", "designer"]},
    "label": {"type": "string"},
    "risk_level": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "requires_confidence": {"type": "boolean"},
    "minimum_confidence": {"type": "number", "minimum": 0, "maximum": 100},
    "result_event_type": {"type": "string"},
    "description": {"type": "string"}
  },
  "if": {
    "properties": {
      "requires_confidence": { "const": true }
    }
  },
  "then": {
    "required": ["minimum_confidence"]
  }
}
