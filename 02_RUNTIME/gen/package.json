    "@types/supertest": "^2.0.12",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.1.0",
    "supertest": "^6.3.3",
    "tsx": "^4.0.0",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.58.0",
