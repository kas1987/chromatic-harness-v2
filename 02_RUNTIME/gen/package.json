{
  "name": "gen",
  "version": "1.0.0",
  "description": "Gen (Magic Genie) — decision middleware layer for Claude Code tool use orchestration",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest",
    "test:run": "vitest --run",
    "test:dispatch-ui": "vitest run tests/integration/dispatch-ui.test.ts --config vitest.dispatch-ui.config.ts",
    "lint": "eslint src"
  },
  "keywords": [
    "orchestration",
    "middleware",
    "decision-making",
    "tool-use"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.24.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.72.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.214.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.214.0",
    "@opentelemetry/resources": "^2.6.1",
    "@opentelemetry/sdk-metrics": "^2.6.1",
    "@opentelemetry/sdk-node": "^0.214.0",
    "@opentelemetry/sdk-trace-node": "^2.6.1",
    "@opentelemetry/semantic-conventions": "^1.40.0",
    "@types/ws": "^8.18.1",
    "better-sqlite3": "^13.0.2",
    "express": "^5.2.1",
    "nanoid": "^6.0.0",
    "node-fetch": "^2.7.0",
    "openai": "^7.2.0",
    "uuid": "^14.0.1",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "^4.17.21",
    "@types/node": "^26.1.2",
    "@types/node-fetch": "^2.6.13",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^10.0.0",
    "eslint": "^10.8.0",
    "supertest": "^7.1.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "playwright": "^1.49.1"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "esbuild@0.21.5": true,
    "protobufjs@7.6.5": true,
    "better-sqlite3@13.0.2": true
  }
