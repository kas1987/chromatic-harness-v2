# Gen (Magic Genie) Configuration

# ============================================================================
# DEVELOPMENT (local/testing)
# ============================================================================
# Authentication token (optional in development, required in production)
GEN_TOKEN=dev-token-for-testing

# Node environment
NODE_ENV=development

# Database path (defaults to ./gen.db if not set)
DATABASE_PATH=./gen.db

# Server port (defaults to 43123 if not set)
GEN_PORT=43123

# ============================================================================
# PRODUCTION (deployment)
# ============================================================================
# Startup validation requires:
#   - NODE_ENV=production
#   - GEN_TOKEN=<secure-random-token-here> (NOT dev-token or test-token)
#   - GEN_ADMIN_TOKEN=<admin-token> (optional, defaults to GEN_TOKEN)
#
# Example:
# NODE_ENV=production
# GEN_TOKEN=<output of: openssl rand -hex 32>
# GEN_ADMIN_TOKEN=<output of: openssl rand -hex 32>

# Embeddings — Ollama (local, default)
GEN_EMBEDDING_URL=http://ollama:11434/v1/embeddings
GEN_EMBEDDING_KEY=ollama
GEN_EMBEDDING_MODEL=nomic-embed-text

# Embeddings — OpenAI (alternative)
# GEN_EMBEDDING_URL=https://api.openai.com/v1/embeddings
# GEN_EMBEDDING_KEY=sk-...
# GEN_EMBEDDING_MODEL=text-embedding-3-small

# TTS — XTTS voice synthesis (TTS-Qwen, port 8765)
TTS_URL=http://127.0.0.1:8765
GEN_ENABLE_TTS=false
GEN_TTS_MODE=direct
TTS_DEFAULT_VOICE=UA___20s_Woman
TTS_AUDIO_DIR=./audio
TTS_TIMEOUT_MS=30000

# Hop remote_mcp rules: base URL for POST .../<destination> (optional)
# GEN_HOP_REMOTE_MCP_URL=http://127.0.0.1:9999/mcp/hop

# Local LLMs — Ollama (optional; Gen uses these for delegate + routing when enabled)
# GEN_OLLAMA_URL=http://127.0.0.1:11434
# GEN_ENABLE_OLLAMA=true
# GEN_OLLAMA_MODEL=qwen3:4b
# Gemma: separate Ollama model tag (pull first: ollama pull gemma3:4b)
# GEN_ENABLE_GEMMA=true
# GEN_GEMMA_OLLAMA_MODEL=gemma3:4b
#
# Per-intent Ollama/Gemma tags (offline-first matrix): set in gen/src/routes/routing-matrix.json
# (taskIntent keys). GEN_OLLAMA_MODEL / GEN_GEMMA_OLLAMA_MODEL remain defaults when a matrix
# step omits localModelTag or for legacy routing (no matching taskIntent).

# Periodic memory consolidation nudge (Hermes-inspired) -- fires every N user-prompts per session (0 = disabled)
# GEN_NUDGE_INTERVAL=5
# Session state TTL for nudge counter in ms (default 10 min)
# GEN_NUDGE_TTL_MS=600000
